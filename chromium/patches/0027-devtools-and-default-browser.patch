+ExtensionFunction::ResponseAction AnusPrivateOpenDevToolsFunction::Run() {
+  auto params = anus_private::OpenDevTools::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  content::WebContents* contents = nullptr;
+  if (!ExtensionTabUtil::GetTabById(params->tab_id, browser_context(),
+                                    /*include_incognito=*/false, &contents)) {
+    return RespondNow(Error(kNoTabError, base::NumberToString(params->tab_id)));
+  }
+  const bool toggle = params->options && params->options->toggle.value_or(false);
+  const bool console =
+      params->options && params->options->console.value_or(false);
+  DevToolsWindow::OpenDevToolsWindow(
+      contents,
+      console  ? DevToolsToggleAction::ShowConsolePanel()
+      : toggle ? DevToolsToggleAction::Toggle()
+               : DevToolsToggleAction::Show(),
+      console ? DevToolsOpenedByAction::kConsoleShortcut
+              : DevToolsOpenedByAction::kMainMenuOrMainShortcut);
+  return RespondNow(NoArguments());
+}
+
+namespace {
+
+base::DictValue DefaultBrowserState(
+    shell_integration::DefaultWebClientState state) {
+  return base::DictValue()
+      .Set("isDefault", state == shell_integration::IS_DEFAULT)
+      .Set("canSet", shell_integration::CanSetAsDefaultBrowser());
 }
 
+}  // namespace
+
+ExtensionFunction::ResponseAction AnusPrivateIsDefaultBrowserFunction::Run() {
+  base::MakeRefCounted<shell_integration::DefaultBrowserWorker>()
+      ->StartCheckIsDefault(base::BindOnce(
+          [](scoped_refptr<AnusPrivateIsDefaultBrowserFunction> function,
+             shell_integration::DefaultWebClientState state) {
+            function->Respond(function->WithArguments(DefaultBrowserState(state)));
+          },
+          scoped_refptr<AnusPrivateIsDefaultBrowserFunction>(this)));
+  return RespondLater();
+}
+
+ExtensionFunction::ResponseAction
+AnusPrivateMakeDefaultBrowserFunction::Run() {
+  base::MakeRefCounted<shell_integration::DefaultBrowserWorker>()
+      ->StartSetAsDefault(base::BindOnce(
+          [](scoped_refptr<AnusPrivateMakeDefaultBrowserFunction> function,
+             shell_integration::DefaultWebClientState state) {
+            function->Respond(function->WithArguments(DefaultBrowserState(state)));
+          },
+          scoped_refptr<AnusPrivateMakeDefaultBrowserFunction>(this)));
+  return RespondLater();
+}
