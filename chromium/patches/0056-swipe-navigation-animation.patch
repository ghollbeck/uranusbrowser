+- (instancetype)initWithImage:(CGImageRef)image
+                      forPage:(NSView*)page
+                    direction:(history_swiper::NavigationDirection)direction {
+  if ((self = [super initWithFrame:page.frame])) {
+    _direction = direction;
+    CALayer* root = [CALayer layer];
+    self.layer = root;
+    self.wantsLayer = YES;
+    self.autoresizingMask = page.autoresizingMask;
+
+    _image = [CALayer layer];
+    _image.frame = root.bounds;
+    _image.contents = (__bridge id)image;
+    _image.contentsGravity = kCAGravityResize;
+    _image.contentsScale = page.window.backingScaleFactor ?: 2;
+    _image.shadowOpacity = 0.28;
+    _image.shadowRadius = 22;
+    _image.shadowOffset = CGSizeZero;
+    CGPathRef shadow = CGPathCreateWithRect(_image.bounds, nullptr);
+    _image.shadowPath = shadow;
+    CGPathRelease(shadow);
+    [root addSublayer:_image];
+
+    // The swipe's arrow badge lives in the page view; bring it on top of the
+    // snapshot so its exit animation stays visible.
+    [page.superview addSubview:self positioned:NSWindowAbove relativeTo:page];
+    for (NSView* sub in [page.subviews copy]) {
+      if ([sub isKindOfClass:NSClassFromString(@"HistoryOverlayView")]) {
+        NSRect frame = [self convertRect:sub.frame fromView:page];
+        [sub removeFromSuperview];
+        sub.frame = frame;
+        [self addSubview:sub];
+      }
+    }
+  }
+  return self;
