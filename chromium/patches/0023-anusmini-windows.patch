+bool& AnusLinksOpenInAnusMini() {
+  // The spike's default (state.openLinksInAnusMini !== false), until the
+  // shell says otherwise.
+  static bool open_in_anusmini = true;
+  return open_in_anusmini;
+}
+
+bool MaybeOpenLinkInAnusMini(Profile* profile, const GURL& url) {
+  if (!profile || !AnusLinksOpenInAnusMini() || !url.is_valid()) {
+    return false;
+  }
+  profile = profile->GetOriginalProfile();
+  // Only once UrAnus Browser's window is up; at launch the link opens as usual.
+  if (!AnusFrameHost::Main(profile) ||
+      GetBrowserWindowCreationStatusForProfile(*profile) !=
+          BrowserWindowInterface::CreationStatus::kOk) {
+    return false;
+  }
+  BrowserWindowInterface* browser = CreateAnusMiniWindow(profile);
+  chrome::AddTabAt(browser, url, -1, /*foreground=*/true);
+  browser->GetWindow()->Show();
+  browser->GetWindow()->Activate();
+  return true;
+}
