   return RespondNow(NoArguments());
 }
 
+ExtensionFunction::ResponseAction AnusPrivateOpenAnusMiniFunction::Run() {
+  auto params = anus_private::OpenAnusMini::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  Profile* profile =
+      Profile::FromBrowserContext(browser_context())->GetOriginalProfile();
+  GURL url(chrome::kChromeUINewTabURL);
+  std::optional<int> tab_id;
+  if (params->options) {
+    if (params->options->url) {
+      url = GURL(*params->options->url);
+      if (!url.is_valid()) {
+        return RespondNow(Error("Invalid url: " + *params->options->url));
+      }
+    }
+    tab_id = params->options->tab_id;
+  }
+  if (GetBrowserWindowCreationStatusForProfile(*profile) !=
+      BrowserWindowInterface::CreationStatus::kOk) {
+    return RespondNow(Error("Can't open a window now."));
+  }
+
+  BrowserWindowInterface* browser = CreateAnusMiniWindow(profile);
+
+  if (tab_id) {
+    std::string error;
+    if (tabs_util::MoveTabToWindow(this, *tab_id, browser, 0,
+                                   /*allow_other_window_types=*/true,
+                                   &error) < 0) {
+      browser->GetWindow()->Close();
+      return RespondNow(Error(error));
+    }
+    browser->GetTabStripModel()->ActivateTabAt(0);
+  } else {
+    chrome::AddTabAt(browser, url, -1, /*foreground=*/true);
+  }
+  browser->GetWindow()->Show();
+  return RespondNow(WithArguments(browser->GetSessionID().id()));
+}
+
+ExtensionFunction::ResponseAction AnusPrivateOpenInAnusFunction::Run() {
+  auto params = anus_private::OpenInAnus::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  AnusFrameHost* anusmini =
+      AnusMiniHost(params->window_id, browser_context());
+  if (!anusmini) {
+    return RespondNow(Error("No AnusMini with id *.",
+                            base::NumberToString(params->window_id)));
+  }
+  AnusFrameHost* main = AnusFrameHost::Main(anusmini->GetBrowserContext());
+  if (!main) {
+    return RespondNow(Error("UrAnus Browser has no main window."));
+  }
+  BrowserWindowInterface* source = anusmini->GetBrowserWindowInterface();
+  BrowserWindowInterface* target = main->GetBrowserWindowInterface();
+  content::WebContents* contents =
+      source->GetTabStripModel()->GetActiveWebContents();
+  if (!contents) {
+    return RespondNow(Error("The AnusMini has no page."));
+  }
+  const int tab_id = ExtensionTabUtil::GetTabId(contents);
+  std::string error;
+  const int index = tabs_util::MoveTabToWindow(
+      this, tab_id, target, -1, /*allow_other_window_types=*/true, &error);
+  if (index < 0) {
+    return RespondNow(Error(error));
+  }
+  target->GetTabStripModel()->ActivateTabAt(index);
+  target->GetWindow()->Activate();
+  // Empty now, so Chromium closes it; any other tabs it had stay with it.
+  return RespondNow(WithArguments(tab_id));
+}
+
+ExtensionFunction::ResponseAction AnusPrivateGetAnusMinisFunction::Run() {
+  base::ListValue ids;
+  for (AnusFrameHost* host : AnusFrameHost::All()) {
+    if (host->IsAnusMini() && SameProfile(host, browser_context())) {
+      ids.Append(host->GetWindowId());
+    }
+  }
+  return RespondNow(WithArguments(std::move(ids)));
+}
