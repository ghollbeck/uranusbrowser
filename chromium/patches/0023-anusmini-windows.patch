+// static
+AnusFrameHost* AnusFrameHost::ForWindow(int window_id) {
+  for (AnusFrameHost* host : Hosts()) {
+    if (host->GetWindowId() == window_id) {
+      return host;
+    }
+  }
+  return nullptr;
+}
+
+// static
+AnusFrameHost* AnusFrameHost::Main(content::BrowserContext* context) {
+  AnusFrameHost* fallback = nullptr;
+  for (AnusFrameHost* host : Hosts()) {
+    if (host->IsAnusMini() || host->GetBrowserContext() != context) {
+      continue;
+    }
+    if (host->IsActiveWindow()) {
+      return host;
+    }
+    fallback = host;
+  }
+  return fallback;
+}
+
+// static
+bool& AnusFrameHost::CreatingAnusMini() {
+  static bool creating = false;
+  return creating;
+}
+
 AnusFrameHost::AnusFrameHost() {
   Hosts().push_back(this);
 }
