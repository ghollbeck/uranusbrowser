+#include "chrome/browser/ui/views/frame/anus_frame_view.h"
+
+#include <string>
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/extensions/chrome_extension_web_contents_observer.h"
+#include "chrome/browser/anus/anus_shell.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/anus_top_chrome.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/view_type_utils.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/mojom/view_type.mojom.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/webview/web_contents_set_background_color.h"
+
+namespace {
+
+// The window background behind the page area; the frame page draws over it.
+class AnusFrameBackgroundView : public views::View {
+  METADATA_HEADER(AnusFrameBackgroundView, views::View)
+
+ public:
+  AnusFrameBackgroundView() {
+    // Only paints: clicks fall through to the window (and drag it).
+    SetCanProcessEventsWithinSubtree(false);
+    SetVisible(false);
+  }
+};
+
+BEGIN_METADATA(AnusFrameBackgroundView)
+END_METADATA
+
+// Wide enough to cover any window, for an overlay.
+constexpr int kOverlayWidth = 1 << 20;
+
+}  // namespace
+
+// static
+AnusFrameView* AnusFrameView::MaybeCreate(BrowserView* browser_view) {
+  if (!AnusHidesTopChrome(browser_view->browser()) ||
+      browser_view->browser()->GetProfile()->IsOffTheRecord()) {
+    return nullptr;
+  }
+  return browser_view->AddChildView(
+      std::make_unique<AnusFrameView>(browser_view));
+}
+
+// static
+AnusFrameView* AnusFrameView::From(views::View* browser_view) {
+  if (!browser_view) {
+    return nullptr;
+  }
+  for (views::View* child : browser_view->children()) {
+    if (auto* frame = views::AsViewClass<AnusFrameView>(child)) {
+      return frame;
+    }
+  }
+  return nullptr;
+}
+
+AnusFrameView::AnusFrameView(BrowserView* browser_view)
+    : views::WebView(browser_view->browser()->GetProfile()), browser_view_(browser_view) {
+  // Stays hidden until the shell is loaded and the frame page opens.
+  SetVisible(false);
+  // Under every other view of the window.
+  background_view_.SetView(browser_view->AddChildViewAt(
+      std::make_unique<AnusFrameBackgroundView>(), 0));
+  if (const auto& state = AnusFrameHost::DefaultState()) {
+    state_ = *state;
+  }
+  ApplyState();
+
+  auto* registry = extensions::ExtensionRegistry::Get(GetBrowserContext());
+  registry_observation_.Observe(registry);
+  if (registry->ready_extensions().Contains(kAnusShellExtensionId)) {
+    OpenFramePage();
+  }
+}
+
+AnusFrameView::~AnusFrameView() {
+  SetWebContents(nullptr);
+}
+
+gfx::Size AnusFrameView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // The browser view layout reads the frame's width from here (it doesn't know
+  // this class); the frame is as tall as the window.
+  return gfx::Size(state_.FrameWidth(kOverlayWidth), 0);
+}
+
+int AnusFrameView::GetWindowId() const {
+  return browser_view_->browser()->GetSessionID().id();
+}
+
+content::BrowserContext* AnusFrameView::GetBrowserContext() {
+  return browser_view_->browser()->GetProfile();
+}
+
+content::WebContents* AnusFrameView::GetFrameContents() {
+  return frame_contents_.get();
+}
+
+bool AnusFrameView::IsActiveWindow() const {
+  return browser_view_->IsActive();
+}
+
+void AnusFrameView::SetFrameState(const AnusFrameState& state) {
+  if (state == state_) {
+    return;
+  }
+  state_ = state;
+  ApplyState();
+}
+
+void AnusFrameView::FocusFrame() {
+  if (frame_contents_) {
+    RequestFocus();
+    frame_contents_->Focus();
+  }
+}
+
+void AnusFrameView::FocusPage() {
+  if (views::WebView* page = browser_view_->GetActiveContentsWebView()) {
+    page->RequestFocus();
+    if (page->web_contents()) {
+      page->web_contents()->Focus();
+    }
+  }
+}
+
+content::WebContents* AnusFrameView::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  // The frame page stays the shell's; anything else it opens goes to a tab.
+  WindowOpenDisposition disposition = params.disposition;
+  if (disposition == WindowOpenDisposition::kCurrentTab) {
+    if (params.url.SchemeIs(extensions::kExtensionScheme) &&
+        IsAnusShell(params.url.host())) {
+      source->GetController().LoadURLWithParams(
+          content::NavigationController::LoadURLParams(params));
+      return source;
+    }
+    disposition = WindowOpenDisposition::kNewForegroundTab;
+  }
+  browser_view_->browser()->OpenGURL(params.url, disposition);
+  return nullptr;
+}
+
+content::KeyboardEventProcessingResult AnusFrameView::PreHandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  // The window's shortcuts (Cmd+T, Cmd+L, ...) work with the frame focused.
+  return browser_view_->PreHandleKeyboardEvent(event);
+}
+
+bool AnusFrameView::HandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  return browser_view_->HandleKeyboardEvent(event);
+}
+
+void AnusFrameView::OnExtensionReady(content::BrowserContext* browser_context,
+                                       const extensions::Extension* extension) {
+  if (IsAnusShell(extension->id())) {
+    OpenFramePage();
+  }
+}
+
+void AnusFrameView::OnExtensionUnloaded(
+    content::BrowserContext* browser_context,
+    const extensions::Extension* extension,
+    extensions::UnloadedExtensionReason reason) {
+  if (IsAnusShell(extension->id())) {
+    CloseFramePage();
+  }
+}
+
+void AnusFrameView::OpenFramePage() {
+  CloseFramePage();
+
+  const GURL url =
+      extensions::Extension::GetBaseURLFromExtensionId(kAnusShellExtensionId)
+          .Resolve("window.html?window=" +
+                   base::NumberToString(GetWindowId()));
+  content::BrowserContext* context = GetBrowserContext();
+  frame_contents_ = content::WebContents::Create(content::WebContents::CreateParams(
+      context, content::SiteInstance::CreateForURL(context, url)));
+  // The page area shows through wherever the frame page draws nothing.
+  views::WebContentsSetBackgroundColor::CreateForWebContentsWithColor(
+      frame_contents_.get(), SK_ColorTRANSPARENT);
+  extensions::SetViewType(frame_contents_.get(),
+                          extensions::mojom::ViewType::kComponent);
+  extensions::ChromeExtensionWebContentsObserver::CreateForWebContents(
+      frame_contents_.get());
+  frame_contents_->SetDelegate(this);
+  SetWebContents(frame_contents_.get());
+  frame_contents_->GetController().LoadURL(url, content::Referrer(),
+                                           ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                           std::string());
+
+  SetVisible(true);
+  if (views::View* background = background_view()) {
+    background->SetVisible(true);
+  }
+  ApplyState();
+}
+
+void AnusFrameView::CloseFramePage() {
+  if (!frame_contents_) {
+    return;
+  }
+  SetVisible(false);
+  if (views::View* background = background_view()) {
+    background->SetVisible(false);
+  }
+  SetWebContents(nullptr);
+  frame_contents_.reset();
+  ApplyState();
+}
+
+void AnusFrameView::ApplyState() {
+  if (views::View* background = background_view()) {
+    background->SetBackground(views::CreateSolidBackground(state_.background));
+    background->SetBorder(views::CreateEmptyBorder(state_.PageInsets()));
+  }
+  PreferredSizeChanged();
+  browser_view_->InvalidateLayout();
+}
+
+BEGIN_METADATA(AnusFrameView)
+END_METADATA
