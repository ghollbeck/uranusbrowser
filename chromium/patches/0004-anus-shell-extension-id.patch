+#ifndef CHROME_BROWSER_ANUS_ANUS_SHELL_H_
+#define CHROME_BROWSER_ANUS_ANUS_SHELL_H_
+
+#include <string_view>
+
+// UrAnus Browser's shell extension (chromium/shell in the UrAnus Browser repo): the window
+// frame, the new tab page and Settings. Its ID is fixed by the "key" in
+// chromium/shell/manifest.json, so it stays the same wherever the unpacked
+// extension is loaded from. Change both together.
+inline constexpr char kAnusShellExtensionId[] =
+    "abdiaepfgbbhdjaecjipmaailijaaide";
+
+inline bool IsAnusShell(std::string_view extension_id) {
+  return extension_id == kAnusShellExtensionId;
+}
+
+#endif  // CHROME_BROWSER_ANUS_ANUS_SHELL_H_
