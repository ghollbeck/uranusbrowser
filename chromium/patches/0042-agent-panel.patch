+void AnusFrameView::SetAgentPanel(bool open, bool left, int width,
+                                    bool focus) {
+  agent_panel_open_ = open;
+  agent_panel_left_ = left;
+  agent_panel_width_ = std::clamp(width, kAnusAgentPanelMinWidth,
+                                  kAnusAgentPanelMaxWidth);
+  UpdateAgentPanelPage();
+  ApplyState();
