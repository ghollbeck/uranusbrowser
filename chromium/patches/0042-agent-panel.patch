+ExtensionFunction::ResponseAction AnusPrivateSetAgentPanelFunction::Run() {
+  auto params = anus_private::SetAgentPanel::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  if (params->state.side == anus_private::AgentPanelSide::kNone) {
+    return RespondNow(BadMessage());
+  }
+  const bool left = params->state.side == anus_private::AgentPanelSide::kLeft;
+  const int width =
+      std::clamp(params->state.width, kAnusAgentPanelMinWidth,
+                 kAnusAgentPanelMaxWidth);
+  const bool focus = params->state.focus.value_or(false);
+
+  if (params->window_id) {
+    AnusFrameHost* host = HostForWindow(*params->window_id, browser_context());
+    if (!host) {
+      return RespondNow(Error(kNoWindowError,
+                              base::NumberToString(*params->window_id)));
+    }
+    host->SetAgentPanel(params->state.open, left, width, focus);
+    return RespondNow(NoArguments());
+  }
+  for (AnusFrameHost* host : AnusFrameHost::All()) {
+    if (SameProfile(host, browser_context())) {
+      host->SetAgentPanel(params->state.open, left, width, focus);
+    }
   }
   return RespondNow(NoArguments());
 }
