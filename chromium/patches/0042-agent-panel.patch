+class AnusFrameView::AgentPanel : public content::WebContentsDelegate {
+ public:
+  AgentPanel(AnusFrameView* frame, const GURL& url) : frame_(frame) {
+    content::BrowserContext* context = frame->GetBrowserContext();
+    contents_ = content::WebContents::Create(content::WebContents::CreateParams(
+        context, content::SiteInstance::CreateForURL(context, url)));
+    // The window's colour shows around the panel's card.
+    views::WebContentsSetBackgroundColor::CreateForWebContentsWithColor(
+        contents_.get(), SK_ColorTRANSPARENT);
+    extensions::SetViewType(contents_.get(),
+                            extensions::mojom::ViewType::kComponent);
+    extensions::ChromeExtensionWebContentsObserver::CreateForWebContents(
+        contents_.get());
+    contents_->SetDelegate(this);
+    contents_->GetController().LoadURL(url, content::Referrer(),
+                                       ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                       std::string());
+  }
+  ~AgentPanel() override { contents_->SetDelegate(nullptr); }
+
+  content::WebContents* contents() { return contents_.get(); }
+
+  // content::WebContentsDelegate:
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override {
+    if (params.disposition == WindowOpenDisposition::kCurrentTab &&
+        params.url.SchemeIs(extensions::kExtensionScheme) &&
+        IsAnusShell(params.url.host())) {
+      source->GetController().LoadURLWithParams(
+          content::NavigationController::LoadURLParams(params));
+      return source;
+    }
+    frame_->browser_view_->browser()->OpenGURL(
+        params.url, WindowOpenDisposition::kNewForegroundTab);
+    return nullptr;
+  }
+  content::KeyboardEventProcessingResult PreHandleKeyboardEvent(
+      content::WebContents* source,
+      const input::NativeWebKeyboardEvent& event) override {
+    // As in the frame page: keys without Command or Control are the panel's
+    // own (Escape closes it), the rest are the window's shortcuts.
+    constexpr int kShortcutModifiers =
+        blink::WebInputEvent::kMetaKey | blink::WebInputEvent::kControlKey;
+    if (!(event.GetModifiers() & kShortcutModifiers)) {
+      return content::KeyboardEventProcessingResult::NOT_HANDLED;
+    }
+    return frame_->browser_view_->PreHandleKeyboardEvent(event);
+  }
+  bool HandleKeyboardEvent(
+      content::WebContents* source,
+      const input::NativeWebKeyboardEvent& event) override {
+    return frame_->browser_view_->HandleKeyboardEvent(event);
+  }
+
+ private:
+  raw_ptr<AnusFrameView> frame_;
+  std::unique_ptr<content::WebContents> contents_;
+};
