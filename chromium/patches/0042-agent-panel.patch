+
+int AnusFrameView::AgentPanelWidth() const {
+  // AnusMinis have no panel, and it waits for the frame page (the shell).
+  if (!agent_panel_open_ || !agent_panel_ || state_.anusmini) {
+    return 0;
+  }
+  const int half_window = browser_view_->width() / 2;
+  const int width = std::max(kAnusAgentPanelMinWidth,
+                             std::min(agent_panel_width_, half_window));
+  // A window too narrow for the panel and a usable page (beside the sidebar)
+  // leaves it out until the window is wider again.
+  constexpr int kMinPageWidth = 320;
+  if (browser_view_->width() - width < kAnusSidebarWidth + kMinPageWidth) {
+    return 0;
+  }
+  return width;
+}
+
+void AnusFrameView::UpdateAgentPanelPage() {
+  auto* panel_view = views::AsViewClass<AnusAgentPanelWebView>(agent_panel_view_.view());
+  if (!panel_view) {
+    return;
+  }
+  const bool wanted =
+      agent_panel_open_ && frame_contents_ && !state_.anusmini;
+  if (wanted && !agent_panel_) {
+    // Loaded once and kept while the window lives, so closing and reopening
+    // the panel keeps its scroll position and what's being typed.
+    agent_panel_ = std::make_unique<AgentPanel>(
+        this, extensions::Extension::GetBaseURLFromExtensionId(
+                  kAnusShellExtensionId)
+                  .Resolve("agent.html?window=" +
+                           base::NumberToString(GetWindowId())));
+    panel_view->SetWebContents(agent_panel_->contents());
+  }
+  const bool focused = panel_view->HasFocus() ||
+                       (agent_panel_ && agent_panel_->contents()
+                                            ->GetRenderWidgetHostView() &&
+                        agent_panel_->contents()
+                            ->GetRenderWidgetHostView()
+                            ->HasFocus());
+  panel_view->SetVisible(wanted);
+  // Closing the panel while it has the keyboard gives it back to the page.
+  if (!wanted && focused) {
+    FocusPage();
+  }
+}
