+// Copyright 2026 The Uranus Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/anus/anus_frame_host.h"
+
+#include "base/no_destructor.h"
+
+namespace {
+
+std::vector<AnusFrameHost*>& Hosts() {
+  static base::NoDestructor<std::vector<AnusFrameHost*>> hosts;
+  return *hosts;
+}
+
+}  // namespace
+
+// static
+const std::vector<AnusFrameHost*>& AnusFrameHost::All() {
+  return Hosts();
+}
+
+// static
+std::optional<AnusFrameState>& AnusFrameHost::DefaultState() {
+  static std::optional<AnusFrameState> state;
+  return state;
+}
+
+AnusFrameHost::AnusFrameHost() {
+  Hosts().push_back(this);
+}
+
+AnusFrameHost::~AnusFrameHost() {
+  std::erase(Hosts(), this);
+}
