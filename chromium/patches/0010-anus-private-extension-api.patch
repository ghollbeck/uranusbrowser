+// Copyright 2026 The Uranus Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Use the <code>chrome.anusPrivate</code> API to lay out Uranus Browser's browser
+// window: the shell's frame page (window.html) is a transparent view over the
+// window, and the browser places the page area and the window controls (the
+// macOS traffic lights) around it. Only Uranus Browser's shell may use it; the
+// contract is chromium/shell/anusPrivate.d.ts in the Uranus Browser repo.
+namespace anusPrivate {
+  // Where the sidebar is.
+  enum SidebarMode {
+    // A strip at the window's left edge; the page area is beside it.
+    docked,
+    // Out of the way; a thin strip at the left edge brings it back on hover.
+    hidden,
+    // Floating over the page, which stays where it is with the sidebar hidden.
+    floating
+  };
+
+  // What keyboard focus moves to.
+  enum FocusTarget {
+    // The frame page (for its command bar).
+    frame,
+    // The active page.
+    page
+  };
+
+  dictionary FrameState {
+    SidebarMode sidebar;
+    // The frame page covers the whole window (command bar, Peek, tour, tab
+    // drag); the page area doesn't move.
+    boolean overlay;
+    // The window's colour behind the page area, as #rrggbb.
+    DOMString background;
+  };
+
+  callback DoneCallback = void();
+  callback WindowIdCallback = void(long windowId);
+
+  interface Functions {
+    // Lays out a window's frame. Applies to every normal window (and to the
+    // windows opened later) when <code>windowId</code> is omitted.
+    static void setFrame(
+        FrameState state,
+        optional long windowId,
+        optional DoneCallback callback);
+
+    // Moves keyboard focus to the frame page or back to the active page, in
+    // the given window, the caller's window or the last active window.
+    static void focus(
+        FocusTarget target,
+        optional long windowId,
+        optional DoneCallback callback);
+
+    // The window the calling frame page belongs to.
+    static void getWindowId(WindowIdCallback callback);
+  };
+};
