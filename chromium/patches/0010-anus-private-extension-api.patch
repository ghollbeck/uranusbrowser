+// Copyright 2026 The Uranus Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ANUS_ANUS_FRAME_HOST_H_
+#define CHROME_BROWSER_ANUS_ANUS_FRAME_HOST_H_
+
+#include <algorithm>
+#include <optional>
+#include <vector>
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace content {
+class BrowserContext;
+class WebContents;
+}
+
+// Uranus Browser's window frame: the shell's frame page (window.html) is a transparent
+// view over each normal window, and the browser lays the page area and the
+// window controls out around it, the way the Electron spike's Browser.layout()
+// did (src/main/main.ts in the Uranus Browser repo). chrome.anusPrivate drives it;
+// the contract is chromium/shell/anusPrivate.d.ts.
+//
+// This target (chrome/browser/anus:anus_frame_host) has no dependencies on
+// views so that the extension API can reach the frames, which live in the
+// browser views (chrome/browser/ui/views/frame/anus_frame_view.h).
+
+// The spike's layout constants.
+inline constexpr int kAnusSidebarWidth = 260;
+// With the sidebar hidden, this strip at the left edge brings it back on hover.
+inline constexpr int kAnusEdgeWidth = 8;
+// The floating sidebar's inset from the window edge, and the room on its right
+// for its shadow.
+inline constexpr int kAnusFloatMargin = 10;
+inline constexpr int kAnusFloatShadow = 28;
+// Where the traffic lights sit (top-left of the close button) to line up with
+// the sidebar's toolbar.
+inline constexpr int kAnusTrafficLightsX = 16;
+inline constexpr int kAnusTrafficLightsY = 18;
+// The gap around the page area.
+inline constexpr int kAnusGap = 8;
+
+struct AnusFrameState {
+  enum class Sidebar { kDocked, kHidden, kFloating };
+
+  Sidebar sidebar = Sidebar::kDocked;
+  bool overlay = false;
+  SkColor background = SkColorSetRGB(0xe9, 0xec, 0xf2);
+
+  bool operator==(const AnusFrameState&) const = default;
+
+  // The frame view's width, from the window's left edge; it is as tall as the
+  // window.
+  int FrameWidth(int window_width) const {
+    if (overlay) {
+      return window_width;
+    }
+    switch (sidebar) {
+      case Sidebar::kDocked:
+        return std::min(window_width, kAnusSidebarWidth);
+      case Sidebar::kHidden:
+        return std::min(window_width, kAnusEdgeWidth);
+      case Sidebar::kFloating:
+        return std::min(window_width, kAnusFloatMargin + kAnusSidebarWidth +
+                                          kAnusFloatShadow);
+    }
+  }
+
+  // The page area, as insets from the window's edges.
+  gfx::Insets PageInsets() const {
+    return gfx::Insets::TLBR(
+        kAnusGap,
+        sidebar == Sidebar::kDocked ? kAnusSidebarWidth : kAnusGap,
+        kAnusGap, kAnusGap);
+  }
+
+  bool TrafficLightsVisible() const { return sidebar != Sidebar::kHidden; }
+
+  // Top-left of the close button, from the window's top-left corner.
+  gfx::Point TrafficLightsOrigin() const {
+    const int inset = sidebar == Sidebar::kFloating ? kAnusFloatMargin : 0;
+    return gfx::Point(kAnusTrafficLightsX + inset,
+                      kAnusTrafficLightsY + inset);
+  }
+};
+
+// One per normal browser window that shows the frame (AnusFrameView).
+class AnusFrameHost {
+ public:
+  // Every live frame host, oldest first.
+  static const std::vector<AnusFrameHost*>& All();
+
+  // The state that setFrame() last gave every window, for windows opened
+  // after it.
+  static std::optional<AnusFrameState>& DefaultState();
+
+  // The extension window ID (the window's session ID) of this host's window.
+  virtual int GetWindowId() const = 0;
+  // The profile of this host's window.
+  virtual content::BrowserContext* GetBrowserContext() = 0;
+  // The frame page's contents, or null before the shell is loaded.
+  virtual content::WebContents* GetFrameContents() = 0;
+  // Whether the window was the last one active (among this profile's).
+  virtual bool IsActiveWindow() const = 0;
+  virtual void SetFrameState(const AnusFrameState& state) = 0;
+  virtual void FocusFrame() = 0;
+  virtual void FocusPage() = 0;
+
+ protected:
+  AnusFrameHost();
+  virtual ~AnusFrameHost();
+};
+
+#endif  // CHROME_BROWSER_ANUS_ANUS_FRAME_HOST_H_
