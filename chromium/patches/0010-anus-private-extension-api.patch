+  ~AnusPrivateSetFrameFunction() override = default;
+  ResponseAction Run() override;
+};
+
+class AnusPrivateFocusFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("anusPrivate.focus", UNKNOWN)
+
+ protected:
+  ~AnusPrivateFocusFunction() override = default;
+  ResponseAction Run() override;
+};
