+// Copyright 2026 The Uranus Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/api/anus_private/anus_private_api.h"
+
+#include <optional>
+#include <string>
+
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/anus/anus_frame_host.h"
+#include "chrome/common/extensions/api/anus_private.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/extensions_browser_client.h"
+
+namespace extensions {
+
+namespace {
+
+namespace anus_private = api::anus_private;
+
+constexpr char kNoWindowError[] = "No Uranus Browser window with id *.";
+constexpr char kNotAFramePageError[] = "The caller is not a frame page.";
+constexpr char kBadColorError[] = "background must be #rrggbb.";
+
+std::optional<SkColor> ParseColor(const std::string& text) {
+  uint32_t rgb = 0;
+  if (text.size() != 7 || text[0] != '#' ||
+      !base::HexStringToUInt(std::string_view(text).substr(1), &rgb)) {
+    return std::nullopt;
+  }
+  return SkColorSetRGB((rgb >> 16) & 0xff, (rgb >> 8) & 0xff, rgb & 0xff);
+}
+
+bool SameProfile(AnusFrameHost* host, content::BrowserContext* context) {
+  return ExtensionsBrowserClient::Get()->IsSameContext(
+      host->GetBrowserContext(), context);
+}
+
+AnusFrameHost* HostForWindow(int window_id,
+                               content::BrowserContext* context) {
+  for (AnusFrameHost* host : AnusFrameHost::All()) {
+    if (host->GetWindowId() == window_id && SameProfile(host, context)) {
+      return host;
+    }
+  }
+  return nullptr;
+}
+
+AnusFrameHost* HostForContents(content::WebContents* contents) {
+  if (!contents) {
+    return nullptr;
+  }
+  for (AnusFrameHost* host : AnusFrameHost::All()) {
+    if (host->GetFrameContents() == contents) {
+      return host;
+    }
+  }
+  return nullptr;
+}
+
+AnusFrameHost* ActiveHost(content::BrowserContext* context) {
+  AnusFrameHost* fallback = nullptr;
+  for (AnusFrameHost* host : AnusFrameHost::All()) {
+    if (!SameProfile(host, context)) {
+      continue;
+    }
+    if (host->IsActiveWindow()) {
+      return host;
+    }
+    fallback = host;
+  }
+  return fallback;
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction AnusPrivateSetFrameFunction::Run() {
+  auto params = anus_private::SetFrame::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  AnusFrameState state;
+  switch (params->state.sidebar) {
+    case anus_private::SidebarMode::kDocked:
+      state.sidebar = AnusFrameState::Sidebar::kDocked;
+      break;
+    case anus_private::SidebarMode::kHidden:
+      state.sidebar = AnusFrameState::Sidebar::kHidden;
+      break;
+    case anus_private::SidebarMode::kFloating:
+      state.sidebar = AnusFrameState::Sidebar::kFloating;
+      break;
+    case anus_private::SidebarMode::kNone:
+      return RespondNow(BadMessage());
+  }
+  state.overlay = params->state.overlay;
+  std::optional<SkColor> background = ParseColor(params->state.background);
+  if (!background) {
+    return RespondNow(Error(kBadColorError));
+  }
+  state.background = *background;
+
+  if (params->window_id) {
+    AnusFrameHost* host = HostForWindow(*params->window_id, browser_context());
+    if (!host) {
+      return RespondNow(Error(kNoWindowError,
+                              base::NumberToString(*params->window_id)));
+    }
+    host->SetFrameState(state);
+    return RespondNow(NoArguments());
+  }
+
+  AnusFrameHost::DefaultState() = state;
+  for (AnusFrameHost* host : AnusFrameHost::All()) {
+    if (SameProfile(host, browser_context())) {
+      host->SetFrameState(state);
+    }
+  }
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction AnusPrivateFocusFunction::Run() {
+  auto params = anus_private::Focus::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  AnusFrameHost* host = nullptr;
+  if (params->window_id) {
+    host = HostForWindow(*params->window_id, browser_context());
+    if (!host) {
+      return RespondNow(Error(kNoWindowError,
+                              base::NumberToString(*params->window_id)));
+    }
+  } else {
+    host = HostForContents(GetSenderWebContents());
+    if (!host) {
+      host = ActiveHost(browser_context());
+    }
+  }
+  if (!host) {
+    return RespondNow(Error(kNoWindowError, "(none)"));
+  }
+
+  switch (params->target) {
+    case anus_private::FocusTarget::kFrame:
+      host->FocusFrame();
+      break;
+    case anus_private::FocusTarget::kPage:
+      host->FocusPage();
+      break;
+    case anus_private::FocusTarget::kNone:
+      return RespondNow(BadMessage());
+  }
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction AnusPrivateGetWindowIdFunction::Run() {
+  AnusFrameHost* host = HostForContents(GetSenderWebContents());
+  if (!host) {
+    return RespondNow(Error(kNotAFramePageError));
+  }
+  return RespondNow(WithArguments(host->GetWindowId()));
+}
+
+}  // namespace extensions
