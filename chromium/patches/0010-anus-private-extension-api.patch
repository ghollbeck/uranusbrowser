+class AnusPrivateGetWindowIdFunction : public ExtensionFunction {
+ public:
+  DECLARE_EXTENSION_FUNCTION("anusPrivate.getWindowId", UNKNOWN)
+
+ protected:
+  ~AnusPrivateGetWindowIdFunction() override = default;
+  ResponseAction Run() override;
